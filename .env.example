# trade-forge environment (API backend)
APP_NAME=trade-forge
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tradeforge
REDIS_URL=redis://localhost:6379/0
DATA_DIR=data

# Enables the real Gemini-powered AI assistant (Pro feature).
# Without it the assistant replies with a "not configured" message.
# Paste your own key here — never commit a real key to the repo.
GEMINI_API_KEY=

# ====== AI Agent (new) ======
# Layer 1 "listener": Cloudflare Workers AI parses Hindi/English strategy text -> DSL.
# Without it the agent uses a local heuristic parser (zero-cost fallback).
CLOUDFLARE_AI_URL=
CLOUDFLARE_AI_TOKEN=
# Layer 3 "brain" review: Groq (free 14k tokens/day) primary, Gemini Flash fallback.
# Without any key the agent shows rule-based review + chips.
GROQ_API_KEY=

# Frontend (build-time): point at the backend.
# Local dev:  http://localhost:8000   (default)
# Docker/VPS: empty string -> same origin (nginx proxies /api -> api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alerts background worker (checks rules every N seconds; off by default).
# Enable on the VPS once deployed: ALERTS_ENABLED=1
ALERTS_ENABLED=0
ALERT_CHECK_INTERVAL_SECONDS=60

# Storage backend for user data (users, strategies, journal, alerts, paper trading, scans).
# "json" = filesystem JSON files (default, no Postgres needed)
# "postgres" = PostgreSQL (set DATABASE_URL above, run scripts/migrate_to_pg.py to move data)
DB_BACKEND=json

# ====== VPS production checklist ======
# 1. ENVIRONMENT=production
# 2. NEXT_PUBLIC_API_URL= (empty — nginx handles /api proxy)
# 3. ALERTS_ENABLED=1
# 4. GEMINI_API_KEY=<your-real-key>
# 5. DATABASE_URL + REDIS_URL use docker-compose service names (postgres/redis)
# 6. DB_BACKEND=postgres (to use PostgreSQL instead of JSON files)
# 7. Run: bash scripts/deploy.sh --setup  (first time)
# 8. Run: python scripts/migrate_to_pg.py  (if switching from json to postgres)
# 9. Run: bash scripts/deploy.sh --ssl yourdomain.com  (HTTPS)
