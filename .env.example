# trade-forge environment (API backend)
APP_NAME=trade-forge
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tradeforge
REDIS_URL=redis://localhost:6379/0
DATA_DIR=data

# Enables the real Gemini-powered AI assistant (Pro feature).
# Without it the assistant replies with a "not configured" message.
GEMINI_API_KEY=

# Frontend (build-time): point at the backend.
# Local dev:  http://localhost:8000   (default)
# Docker:     empty string -> same origin (nginx proxies /api -> api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Alerts background worker (checks rules every N seconds; off by default).
# Enable on the VPS once deployed: ALERTS_ENABLED=1
ALERTS_ENABLED=0
ALERT_CHECK_INTERVAL_SECONDS=60
